# ── LariPay.ai (laripay.ai) ───────────────────────────────────────
TBC_ENV=sandbox
BOG_ENV=sandbox

# ngrok / public URLs (replace abc123 with your tunnel subdomain)
LARIPAY_RETURN_URL=https://abc123.ngrok.io/payment/return
LARIPAY_WEBHOOK_URL=https://abc123.ngrok.io/api/webhook
# Legacy aliases still supported: PAYKA_RETURN_URL, PAYKA_WEBHOOK_URL

# Set to 1 to append /tbc or /bog to LARIPAY_WEBHOOK_URL
# LARIPAY_WEBHOOK_PER_PROVIDER=0

# ── Unified SDK config ────────────────────────────────────────────
FINTECH_PAY_GATEWAY=tbc

# TBC Pay
TBC_CLIENT_ID=
TBC_CLIENT_SECRET=
TBC_API_KEY=

# BOG Pay
BOG_PUBLIC_KEY=
BOG_SECRET_KEY=
BOG_CALLBACK_PUBLIC_KEY=

DEFAULT_CURRENCY=GEL

# ── LariPay.ai platform ───────────────────────────────────────────
LARIPAY_ADMIN_SECRET=change-me-admin-secret
LARIPAY_DEMO_API_KEY=
# 1% default; subscription plans: starter (49 GEL), pro (149 GEL)

# On-site LariPay AI assistant (georgia-pay-app)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# NestJS payment core (services/laripay-core) — optional proxy from Next.js
# LARIPAY_CORE_API_URL=http://localhost:4000
