{
  "name": "georgian-payments",
  "version": "2.0.0",
  "description": "LariPay.ai — Georgian payments (TBC Pay & BOG Pay, GEL)",
  "type": "module",
  "main": "./src/georgian-payments.cjs",
  "module": "./src/georgian-payments.js",
  "exports": {
    ".": {
      "import": "./src/georgian-payments.js",
      "require": "./src/georgian-payments.cjs",
      "default": "./src/georgian-payments.js"
    },
    "./webhooks": {
      "import": "./src/webhooks.js",
      "require": "./src/webhooks.cjs"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "georgia",
    "payments",
    "tbc",
    "bog",
    "gel",
    "fintech",
    "georgian-payments"
  ],
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "5.22.0",
    "next": "14.2.18",
    "prisma": "5.22.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "scripts": {
    "start": "bash scripts/go.sh",
    "dev:laripay": "bash scripts/dev-all.sh",
    "sync:ngrok": "bash scripts/sync-ngrok-url.sh",
    "health": "bash scripts/health-check.sh",
    "test:phase1": "bash scripts/phase1-test.sh",
    "test:phase2": "bash scripts/phase2-test.sh",
    "test:docker": "bash scripts/docker-test.sh",
    "docker:up": "docker compose -f deploy/docker-compose.yml up -d --build",
    "docker:down": "docker compose -f deploy/docker-compose.yml down",
    "docker:logs": "docker compose -f deploy/docker-compose.yml logs -f laripay",
    "core:dev": "cd services/laripay-core && npm run start:dev",
    "core:docker": "cd services/laripay-core && docker compose up -d postgres redis && npx prisma migrate deploy",
    "vercel-build": "bash scripts/vercel-app.sh build"
  }
}
