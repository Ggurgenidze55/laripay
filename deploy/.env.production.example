# Copy to deploy/.env.production (never commit real secrets)

POSTGRES_PASSWORD=change_me_strong_password

# Public URL (no trailing slash)
HOST=https://laripay.ai
NEXT_PUBLIC_HOST=https://laripay.ai
LARIPAY_RETURN_URL=https://laripay.ai/payment/return
LARIPAY_WEBHOOK_URL=https://laripay.ai/api/webhook

# Platform
LARIPAY_ADMIN_SECRET=change_me_admin
LARIPAY_ALLOW_SIGNUP=0
LARIPAY_ALLOW_PUBLIC_DEMO_DASHBOARD=0
LARIPAY_PORTAL_SECRET=
LARIPAY_LOG_WEBHOOKS=0

# Banks (production or sandbox)
TBC_ENV=sandbox
BOG_ENV=sandbox
TBC_API_KEY=
TBC_CLIENT_ID=
TBC_CLIENT_SECRET=
BOG_PUBLIC_KEY=
BOG_SECRET_KEY=
BOG_CALLBACK_PUBLIC_KEY=
DEFAULT_PAYMENT_PROVIDER=tbc

# Shopify (if used)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
NEXT_PUBLIC_SHOPIFY_API_KEY=
SCOPES=write_payment_sessions,read_payment_sessions,write_payment_gateways,read_payment_gateways
