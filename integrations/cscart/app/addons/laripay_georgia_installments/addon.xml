<?xml version="1.0"?>
<addon scheme="3.0">
    <id>laripay_georgia_installments</id>
    <version>1.0.0</version>
    <priority>100501</priority>
    <status>active</status>
    <name>LariPay.ai — Online installments</name>
    <description>Bank-hosted pay-in-parts via Georgian banks (TBC, BOG, Liberty, Credo, Cartu, Basis, Flitt).</description>
    <settings>
        <sections>
            <section id="general">
                <items>
                    <item id="api_url"><type>input</type><default_value>https://laripay.ai</default_value></item>
                    <item id="secret_key"><type>password</type></item>
                    <item id="bank">
                        <type>selectbox</type>
                        <variants>
                            <item id="tbc">TBC Pay</item>
                            <item id="bog">BOG Pay</item>
                            <item id="liberty">Liberty Bank</item>
                            <item id="credo">Credo Bank</item>
                            <item id="cartu">Cartu Bank</item>
                            <item id="basis">Basis Bank</item>
                            <item id="flitt">Flitt</item>
                        </variants>
                        <default_value>tbc</default_value>
                    </item>
                    <item id="installment_terms">
                        <type>selectbox</type>
                        <variants>
                            <item id="">Customer chooses</item>
                            <item id="3">3 months</item>
                            <item id="6">6 months</item>
                            <item id="12">12 months</item>
                            <item id="24">24 months</item>
                        </variants>
                        <default_value></default_value>
                    </item>
                </items>
            </section>
        </sections>
    </settings>
</addon>
