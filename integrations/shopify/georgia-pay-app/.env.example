# Shopify app
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=write_payment_sessions,read_payment_sessions,write_payment_gateways,read_payment_gateways
HOST=https://abc123.ngrok.io
NEXT_PUBLIC_HOST=https://abc123.ngrok.io

NEXT_PUBLIC_SHOPIFY_API_KEY=
DATABASE_URL="file:./dev.db"

# LariPay.ai (laripay.ai) / ngrok
TBC_ENV=sandbox
BOG_ENV=sandbox
LARIPAY_RETURN_URL=https://abc123.ngrok.io/payment/return
LARIPAY_WEBHOOK_URL=https://abc123.ngrok.io/api/webhook
# Legacy aliases (still supported): LARIPAY_RETURN_URL, LARIPAY_WEBHOOK_URL

# Bank credentials
DEFAULT_PAYMENT_PROVIDER=tbc
TBC_API_KEY=
TBC_CLIENT_ID=
TBC_CLIENT_SECRET=
BOG_PUBLIC_KEY=
BOG_SECRET_KEY=
BOG_CALLBACK_PUBLIC_KEY=

# LariPay.ai platform
LARIPAY_ADMIN_SECRET=change-me-admin-secret
LARIPAY_DEMO_API_KEY=
LARIPAY_LOG_WEBHOOKS=0
LARIPAY_ALLOW_SIGNUP=1
# Dev only: allow /laripay/dashboard without login (demo-merchant). Use 0 for production.
LARIPAY_ALLOW_PUBLIC_DEMO_DASHBOARD=0
LARIPAY_PORTAL_SECRET=
# 2FA for register/login/admin (email+SMS codes). Set 0 to disable temporarily.
LARIPAY_REQUIRE_2FA=0

# On-site AI assistant (OpenAI)
OPENAI_API_KEY=
# Optional — default: gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini

# Enterprise NestJS core API (optional — when set, v1 checkout proxies here)
# LARIPAY_CORE_API_URL=http://localhost:4000

# 2FA — real email & SMS (required for register/login/admin)
# Email: https://resend.com — verify your sending domain, then use e.g. LariPay <auth@yourdomain.com>
LARIPAY_RESEND_API_KEY=
LARIPAY_OTP_EMAIL_FROM=LariPay <auth@laripay.ai>
# SMS: https://www.twilio.com — Georgia +995 supported; set Messaging Service or a sender number
LARIPAY_TWILIO_ACCOUNT_SID=
LARIPAY_TWILIO_AUTH_TOKEN=
# Phone number in E.164 (e.g. +15005550006) OR use Messaging Service instead of FROM:
LARIPAY_TWILIO_FROM=
# LARIPAY_TWILIO_MESSAGING_SERVICE_SID=
